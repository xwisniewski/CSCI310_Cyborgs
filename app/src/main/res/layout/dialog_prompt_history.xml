<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@android:color/white">

    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:background="@drawable/bottom_sheet_handle"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textViewHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Version history"
        android:textSize="18sp"
        android:textColor="#222222"
        android:textStyle="bold"
        android:layout_marginBottom="4dp" />

    <TextView
        android:id="@+id/textViewHistorySubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="See every edit with timestamps"
        android:textSize="13sp"
        android:textColor="#666666"
        android:layout_marginBottom="16dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerViewHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="120dp"
        android:overScrollMode="ifContentScrolls"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/textViewHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="No edits yet."
        android:textSize="14sp"
        android:textColor="#888888"
        android:textAlignment="center"
        android:visibility="gone"
        android:layout_marginTop="12dp" />

</LinearLayout>

